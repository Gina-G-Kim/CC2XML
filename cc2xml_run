#!/usr/bin/env python3
"""Executable entry point for this repository - a thin wrapper around
cc2xml.cli.main() so the parser can be run directly (./cc2xml_run ...)
instead of via `python3 -m cc2xml.cli ...`. All the actual logic lives in
cc2xml/cli.py; nothing here is duplicated, only invoked.

    ./cc2xml_run tests/ideal_st.md   # a single file
    ./cc2xml_run --all               # every .md/.txt file in tests/
    ./cc2xml_run --all --no-catalog  # skip Stage-1 cc_2022.xml validation

Exit code is 0 only if every processed file's result was PASS or WARN;
1 if any was FAIL or hit an ERROR - so this is safe to use as a CI/script
gate, not just for its printed output.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from cc2xml.cli import main

if __name__ == '__main__':
    results = main()
    sys.exit(0 if all(status in ('PASS', 'WARN') for _, status, _ in results) else 1)
